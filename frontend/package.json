{
  "name": "caligo-frontend",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
