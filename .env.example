# No actual secrets belong in this file.
APP_ENV=development
DATABASE_URL=sqlite:///./local_dev.sqlite3
# disabled | mock | sandbox. "mock" is an in-process fake (no network, no credentials).
# "sandbox" calls PayPal's TEST environment only and needs the three values below, supplied locally by you
# and never committed. Live/production PayPal does not exist in this codebase.
PAYPAL_MODE=disabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business (merchant) account email; provider evidence must come from this merchant.
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# Comma-separated sandbox buyer test identities that invoices may be addressed to. Nothing else can be invoiced.
PAYPAL_SANDBOX_RECIPIENT_ALLOWLIST=
AI_MODE=disabled
AI_API_KEY=
CORS_ORIGINS=http://localhost:3000
# For local development only. Do not use in production.
DEV_AUTH_ENABLED=false

# Seller sessions. Set COOKIE_SECURE=true whenever the API is served over HTTPS (required when APP_ENV=production).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_WINDOW=10
MAX_BODY_BYTES=1000000
