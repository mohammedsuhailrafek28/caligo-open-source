{
  "$defs": {
    "Clue": {
      "additionalProperties": false,
      "properties": {
        "log_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Log Id",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "negated": {
          "title": "Negated",
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "surface_rule",
            "stanza_lemma"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "log_id",
        "evidence_ref",
        "category",
        "start",
        "end",
        "negated",
        "basis"
      ],
      "title": "Clue",
      "type": "object"
    },
    "ExactCandidate": {
      "additionalProperties": false,
      "properties": {
        "log_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Log Id",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "transaction_id",
            "order_id",
            "amount",
            "currency",
            "timestamp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "verified": {
          "const": false,
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "log_id",
        "evidence_ref",
        "kind",
        "value",
        "start",
        "end"
      ],
      "title": "ExactCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Project Id",
      "type": "string"
    },
    "payment_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Payment Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "deterministic",
        "stanza"
      ],
      "title": "Mode",
      "type": "string"
    },
    "clues": {
      "items": {
        "$ref": "#/$defs/Clue"
      },
      "title": "Clues",
      "type": "array"
    },
    "exact_candidates": {
      "items": {
        "$ref": "#/$defs/ExactCandidate"
      },
      "title": "Exact Candidates",
      "type": "array"
    },
    "contextual_terms": {
      "items": {
        "type": "string"
      },
      "title": "Contextual Terms",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "provenance": {
      "items": {
        "maxItems": 4,
        "minItems": 4,
        "prefixItems": [
          {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          {
            "enum": [
              "provider_authenticated",
              "merchant",
              "simulation",
              "operator",
              "untrusted_log"
            ],
            "type": "string"
          },
          {
            "enum": [
              "simulation",
              "sandbox"
            ],
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Provenance",
      "type": "array"
    },
    "advisory_only": {
      "const": true,
      "default": true,
      "title": "Advisory Only",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "payment_id",
    "mode",
    "clues",
    "exact_candidates",
    "contextual_terms",
    "warnings",
    "provenance"
  ],
  "title": "Extraction",
  "type": "object"
}
