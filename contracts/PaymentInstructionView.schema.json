{
  "$defs": {
    "InstructionProvenance": {
      "enum": [
        "SELLER_ENTERED",
        "INVOICE_REQUEST"
      ],
      "title": "InstructionProvenance",
      "type": "string"
    },
    "InstructionVerification": {
      "enum": [
        "PENDING_VERIFICATION",
        "VERIFIED_BY_ENROLLED_SECOND_CHANNEL"
      ],
      "title": "InstructionVerification",
      "type": "string"
    },
    "PaymentProviderName": {
      "description": "Which backend produced a payment record. MOCK_PAYPAL is never a real transaction;\nPAYPAL_SANDBOX is PayPal's test environment, never real money. PAYPAL (live) is not implemented.",
      "enum": [
        "MOCK_PAYPAL",
        "PAYPAL_SANDBOX",
        "PAYPAL"
      ],
      "title": "PaymentProviderName",
      "type": "string"
    }
  },
  "properties": {
    "amount_minor": {
      "title": "Amount Minor",
      "type": "integer"
    },
    "chain_sha256": {
      "title": "Chain Sha256",
      "type": "string"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "merchant_email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Merchant Email"
    },
    "previous_instruction_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Instruction Id"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/InstructionProvenance"
    },
    "provider": {
      "$ref": "#/$defs/PaymentProviderName"
    },
    "recipient_email": {
      "title": "Recipient Email",
      "type": "string"
    },
    "verification_status": {
      "$ref": "#/$defs/InstructionVerification",
      "default": "PENDING_VERIFICATION"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "project_id",
    "version",
    "provider",
    "merchant_email",
    "recipient_email",
    "currency",
    "amount_minor",
    "context",
    "fingerprint",
    "chain_sha256",
    "previous_instruction_id",
    "provenance",
    "created_at"
  ],
  "title": "PaymentInstructionView",
  "type": "object"
}
