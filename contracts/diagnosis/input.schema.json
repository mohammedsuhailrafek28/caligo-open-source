{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "provider",
            "merchant",
            "simulation",
            "operator",
            "untrusted_log"
          ],
          "title": "Source",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "payment",
            "order",
            "inventory",
            "fulfillment",
            "integration",
            "recovery",
            "log"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "payment_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Payment Id",
          "type": "string"
        },
        "status": {
          "maxLength": 80,
          "title": "Status",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "caused_by_event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caused By Event Id"
        },
        "effect_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Key"
        },
        "text": {
          "default": "",
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "kind",
        "entity_id",
        "payment_id",
        "status",
        "observed_at"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 2000,
      "title": "Evidence",
      "type": "array"
    },
    "incomplete_evidence_warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Incomplete Evidence Warnings",
      "type": "array"
    },
    "observation_window_complete": {
      "default": false,
      "title": "Observation Window Complete",
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "evidence"
  ],
  "title": "DiagnosisInput",
  "type": "object"
}
